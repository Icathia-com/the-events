rules_version = '2';

// Brief section 7. Covered so far: users and the hours ledger, organisations, events (reading, creating, editing),
// registrations (joining, cancelling, the organisation's decisions), who's going, attendance recorded by the
// organisation, reference numbers, and the event's private details. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function myUserPath() {
      return userPath(request.auth.uid);
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function regPath(eventId, uid) {
      return /databases/$(database)/documents/events/$(eventId)/registrations/$(uid);
    }

    function goingPath(eventId, uid) {
      return /databases/$(database)/documents/events/$(eventId)/going/$(uid);
    }

    function attendancePath(eventId, uid) {
      return /databases/$(database)/documents/events/$(eventId)/attendance/$(uid);
    }

    function referencePath(ref) {
      return /databases/$(database)/documents/references/$(ref);
    }

    // networkAdmin is set by hand in the console, never by the app.
    function isNetworkAdmin() {
      return signedIn() && exists(myUserPath()) && get(myUserPath()).data.get('networkAdmin', false) == true;
    }

    function myMemberPath(orgId) {
      return /databases/$(database)/documents/organisations/$(orgId)/members/$(request.auth.uid);
    }

    function isMember(orgId) {
      return signedIn() && exists(myMemberPath(orgId));
    }

    function isOrgAdmin(orgId) {
      return isMember(orgId) && get(myMemberPath(orgId)).data.role == 'admin';
    }

    function followsOrg(orgId) {
      return signedIn() && exists(myUserPath()) && orgId in get(myUserPath()).data.get('follows', []);
    }

    // Fields a volunteer may set on their own profile.
    function validProfile(d) {
      return d.name is string && d.name.size() <= 100
        && d.bio is string && d.bio.size() <= 500
        && d.photoUrl is string && d.photoUrl.size() <= 2048
        && d.follows is list && d.follows.size() <= 200;
    }

    function attendanceConfirmed(eventId, uid) {
      return exists(attendancePath(eventId, uid)) && get(attendancePath(eventId, uid)).data.status == 'confirmed';
    }

    // hoursTotal moves by exactly the hours of the one ledger entry (hoursBy) added or removed in the same write.
    function hoursFollow(uid, entryId) {
      let path = /databases/$(database)/documents/users/$(uid)/hours/$(entryId);
      let before = exists(path) ? get(path).data.hours : 0;
      let after = existsAfter(path) ? getAfter(path).data.hours : 0;
      return exists(path) != existsAfter(path)
        && request.resource.data.hoursTotal == resource.data.get('hoursTotal', 0) + after - before;
    }

    // A new ledger entry copies the confirmed attendance and the event, and registers a new reference number.
    function entryMatchesAttendance(uid, entryId) {
      let att = get(attendancePath(entryId, uid)).data;
      let e = get(eventPath(entryId)).data;
      let h = request.resource.data;
      return att.status == 'confirmed'
        && h.keys().hasOnly(['eventId', 'eventTitle', 'orgId', 'orgName', 'cover', 'date', 'hours', 'confirmedBy', 'confirmedAt', 'reference'])
        && h.eventId == entryId && h.eventTitle == e.title && h.orgId == e.orgId && h.orgName == e.orgName
        && h.cover == e.cover && h.date == e.startAt
        && h.hours == att.hours && h.confirmedBy == att.confirmedBy && h.confirmedAt == att.confirmedAt
        && h.reference is string && h.reference.matches('VN-[0-9]{4}-[0-9]{5}')
        && !exists(referencePath(h.reference))
        && getAfter(referencePath(h.reference)).data.uid == uid
        && getAfter(userPath(uid)).data.get('hoursTotal', 0) == get(userPath(uid)).data.get('hoursTotal', 0) + h.hours;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);

      // First sign-in. networkAdmin and hoursTotal are never set by the client.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'photoUrl', 'bio', 'follows', 'joinedAt', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'photoUrl', 'bio', 'follows', 'joinedAt', 'createdAt', 'updatedAt'])
        && validProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.joinedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'photoUrl', 'follows', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validProfile(request.resource.data);

      // Phase 1 confirm path: hoursTotal moves only with the ledger, in the same write.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hoursTotal', 'hoursBy'])
        && hoursFollow(uid, request.resource.data.hoursBy);

      // The hours ledger: the volunteer, and admins of the organisation named on the entry.
      match /hours/{entryId} {
        allow read: if isSelf(uid) || isOrgAdmin(resource.data.orgId);

        // Phase 1: the volunteer's own app adds the entry once the organisation has confirmed their attendance...
        allow create: if isSelf(uid) && entryMatchesAttendance(uid, entryId);

        // ...and removes it if the organisation undoes that confirmation.
        allow delete: if isSelf(uid) && !attendanceConfirmed(entryId, uid)
          && getAfter(userPath(uid)).data.get('hoursTotal', 0) == get(userPath(uid)).data.get('hoursTotal', 0) - resource.data.hours;
      }
    }

    // Reference numbers (VN-<year>-<5 digits>) are unique: each is registered once, with its ledger entry.
    match /references/{ref} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && ref.matches('VN-[0-9]{4}-[0-9]{5}')
        && request.resource.data.keys().hasOnly(['uid', 'entryId'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/hours/$(request.resource.data.entryId)).data.reference == ref;
    }

    // Collection group queries: people find their own registrations and attendance; organisation admins find the
    // ledger entries that name their organisation.
    match /{path=**}/registrations/{regId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/attendance/{attendanceId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/hours/{entryId} {
      allow read: if isOrgAdmin(resource.data.orgId);
    }

    // An organisation's own profile fields. Status, stats and approval are not among them.
    function validOrgProfile(o) {
      return o.name is string && o.name.size() > 0 && o.name.size() <= 100
        && o.tagline is string && o.tagline.size() <= 120
        && o.about is string && o.about.size() <= 2000
        && o.givingUrl is string && o.givingUrl.size() <= 500 && (o.givingUrl == '' || o.givingUrl.matches('https://\\S+'))
        && o.causes is list && o.causes.size() <= 6
        && o.logoColors is list && o.logoColors.size() == 2;
    }

    match /organisations/{orgId} {
      allow read: if signedIn() && (resource.data.status == 'approved' || isMember(orgId) || isNetworkAdmin());

      allow update: if isOrgAdmin(orgId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'tagline', 'about', 'causes', 'area', 'logoColors', 'givingUrl', 'email', 'address', 'website', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validOrgProfile(request.resource.data);

      match /members/{uid} {
        allow read: if isSelf(uid) || isMember(orgId) || isNetworkAdmin();

        // Someone invited as staff accepts by signing in: their app adds them as staff and removes the invite,
        // in one write. Admins remove staff.
        allow create: if isSelf(uid) && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/organisations/$(orgId)/staffInvites/$(request.auth.token.email.lower()))
          && !existsAfter(/databases/$(database)/documents/organisations/$(orgId)/staffInvites/$(request.auth.token.email.lower()))
          && request.resource.data.keys().hasOnly(['uid', 'role', 'name', 'addedAt'])
          && request.resource.data.uid == uid && request.resource.data.role == 'staff'
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.addedAt == request.time;
        allow delete: if isOrgAdmin(orgId) && resource.data.role == 'staff';
      }

      // Staff invitations, by email: made and withdrawn by admins, read and accepted by the person invited.
      match /staffInvites/{email} {
        allow read: if isOrgAdmin(orgId)
          || (signedIn() && request.auth.token.email_verified == true && email == request.auth.token.email.lower());
        allow create: if isOrgAdmin(orgId)
          && email.matches('[^@\\s]+@[^@\\s]+') && email == email.lower()
          && request.resource.data.keys().hasOnly(['email', 'role', 'invitedBy', 'invitedAt'])
          && request.resource.data.email == email && request.resource.data.role == 'staff'
          && request.resource.data.invitedBy == request.auth.uid && request.resource.data.invitedAt == request.time;
        allow delete: if isOrgAdmin(orgId)
          || (signedIn() && email == request.auth.token.email.lower()
              && existsAfter(/databases/$(database)/documents/organisations/$(orgId)/members/$(request.auth.uid)));
      }
    }

    // Lets an invited person find their staff invitations (a collection group query on their own email).
    match /{path=**}/staffInvites/{email} {
      allow read: if signedIn() && request.auth.token.email_verified == true && resource.data.email == request.auth.token.email.lower();
    }

    // Lets someone find the organisations they belong to (a collection group query on their own uid).
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    function canSee(e) {
      return signedIn() && (
        e.visibility == 'public'
        || (e.visibility == 'followers' && followsOrg(e.orgId))
        || isMember(e.orgId)
        || isNetworkAdmin()
      );
    }

    // A registration's or attendance's status before and after this write ('none' when there is none).
    function statusBefore(eventId, uid) {
      return exists(regPath(eventId, uid)) ? get(regPath(eventId, uid)).data.status : 'none';
    }

    function statusAfter(eventId, uid) {
      return existsAfter(regPath(eventId, uid)) ? getAfter(regPath(eventId, uid)).data.status : 'none';
    }

    function attendanceBefore(eventId, uid) {
      return exists(attendancePath(eventId, uid)) ? get(attendancePath(eventId, uid)).data.status : 'none';
    }

    function attendanceAfter(eventId, uid) {
      return existsAfter(attendancePath(eventId, uid)) ? getAfter(attendancePath(eventId, uid)).data.status : 'none';
    }

    function step(key, before, after) {
      return (after == key ? 1 : 0) - (before == key ? 1 : 0);
    }

    // The counts moved by exactly one registration going from `before` to `after`.
    function countsStep(old, next, before, after) {
      return next.keys().hasOnly(['going', 'pending', 'waitlist', 'attended'])
        && next.going == old.going + step('going', before, after)
        && next.pending == old.pending + step('pending', before, after)
        && next.waitlist == old.waitlist + step('waitlist', before, after)
        && next.attended == old.attended;
    }

    // The counts moved by exactly one person's registration and attendance changes in this write.
    function countsFollow(old, next, eventId, uid) {
      let regBefore = statusBefore(eventId, uid);
      let regAfter = statusAfter(eventId, uid);
      let attBefore = attendanceBefore(eventId, uid);
      let attAfter = attendanceAfter(eventId, uid);
      return (regBefore != regAfter || attBefore != attAfter)
        && next.keys().hasOnly(['going', 'pending', 'waitlist', 'attended'])
        && next.going == old.going + step('going', regBefore, regAfter)
        && next.pending == old.pending + step('pending', regBefore, regAfter)
        && next.waitlist == old.waitlist + step('waitlist', regBefore, regAfter)
        && next.attended == old.attended + step('confirmed', attBefore, attAfter);
    }

    // What joining gives: the waiting list when full (if it has one), pending when approval is on, otherwise going.
    function joinStatus(e) {
      return e.registration.capacity != null && e.counts.going >= e.registration.capacity
        ? (e.registration.waitlist == true ? 'waitlist' : 'full')
        : (e.registration.approval == true ? 'pending' : 'going');
    }

    function openForJoining(e) {
      return e.status == 'scheduled' && e.visibility != 'draft' && e.registration.open == true && e.endAt > request.time
        && (!('opensAt' in e.registration) || e.registration.opensAt <= request.time)
        && (!('closesAt' in e.registration) || e.registration.closesAt > request.time);
    }

    // An event's own fields, as the create and edit form writes them.
    function validEvent(e) {
      return e.title is string && e.title.size() > 0 && e.title.size() <= 120
        && e.description is string && e.description.size() <= 5000
        && e.cause in ['food', 'elderly', 'children', 'environment', 'animals', 'education']
        && e.area in ['north', 'northeast', 'east', 'central', 'west', 'islandwide']
        && e.venue is string && e.venue.size() <= 200
        && e.meetingPoint is string && e.meetingPoint.size() <= 200
        && e.bring is string && e.bring.size() <= 300
        && e.startAt is timestamp && e.endAt is timestamp && e.endAt > e.startAt
        && e.hours is number && e.hours >= 0 && e.hours <= 24
        && e.visibility in ['public', 'followers', 'draft']
        && e.registration.open is bool && e.registration.approval is bool
        && e.registration.waitlist is bool && e.registration.group is bool
        && (e.registration.capacity == null
            || (e.registration.capacity is int && e.registration.capacity > 0 && e.registration.capacity <= 10000))
        && e.cover.colors is list && e.cover.colors.size() == 2 && e.cover.label is string && e.cover.label.size() <= 40
        && e.ticketTypes is list && e.ticketTypes.size() <= 10
        && (!('notifyFollowers' in e) || e.notifyFollowers is bool);
    }

    match /events/{eventId} {
      allow read: if canSee(resource.data);

      // The organisation's admins create its events: scheduled, nobody registered yet, under its real name.
      allow create: if isOrgAdmin(request.resource.data.orgId)
        && request.resource.data.keys().hasOnly(['orgId', 'orgName', 'title', 'description', 'cause', 'area', 'venue',
             'meetingPoint', 'bring', 'startAt', 'endAt', 'hours', 'cover', 'visibility', 'status', 'registration',
             'ticketTypes', 'counts', 'hideExactLocation', 'checkInMode', 'checkInLocked', 'notifyFollowers',
             'createdBy', 'createdAt', 'updatedAt'])
        && validEvent(request.resource.data)
        && request.resource.data.status == 'scheduled'
        && request.resource.data.counts == { 'going': 0, 'pending': 0, 'waitlist': 0, 'attended': 0 }
        && request.resource.data.orgName == get(/databases/$(database)/documents/organisations/$(request.resource.data.orgId)).data.name
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // ...and edit them. The organisation and the counts can't change, and a cancelled event stays cancelled.
      allow update: if isOrgAdmin(resource.data.orgId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'cause', 'area',
             'venue', 'meetingPoint', 'bring', 'startAt', 'endAt', 'hours', 'cover', 'visibility', 'status',
             'registration', 'ticketTypes', 'hideExactLocation', 'checkInMode', 'checkInLocked', 'notifyFollowers', 'updatedAt'])
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'scheduled' && request.resource.data.status == 'cancelled'))
        && validEvent(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      // The counts move only with one person's registration or attendance, changed in the same write; countsBy names
      // that person. Volunteers move them for themselves, the organisation's members for anyone.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts', 'countsBy'])
        && (request.resource.data.countsBy == request.auth.uid || isMember(resource.data.orgId))
        && countsFollow(resource.data.counts, request.resource.data.counts, eventId, request.resource.data.countsBy);

      match /registrations/{uid} {
        allow read: if isSelf(uid) || isMember(get(eventPath(eventId)).data.orgId) || isNetworkAdmin();

        // Joining, or joining again after cancelling. The event decides the status, and the counts and the
        // who's-going entry change in the same write.
        function joinAllowed(before) {
          let e = get(eventPath(eventId)).data;
          let r = request.resource.data;
          let status = joinStatus(e);
          return canSee(e) && openForJoining(e) && status != 'full'
            && r.status == status && r.uid == uid
            && r.name is string && r.name.size() > 0 && r.name.size() <= 100
            && r.ticketTypeId == null && r.answers.size() == 0
            && r.registeredAt == request.time && r.updatedAt == request.time
            && countsStep(e.counts, getAfter(eventPath(eventId)).data.counts, before, status)
            && existsAfter(goingPath(eventId, uid)) == (status == 'going');
        }

        function cancelAllowed() {
          let e = get(eventPath(eventId)).data;
          let r = request.resource.data;
          return resource.data.status in ['going', 'pending', 'waitlist']
            && e.endAt > request.time
            && r.status == 'cancelled'
            && r.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && r.updatedAt == request.time
            && countsStep(e.counts, getAfter(eventPath(eventId)).data.counts, resource.data.status, 'cancelled')
            && !existsAfter(goingPath(eventId, uid));
        }

        // The organisation's admins decide: going, declined or the waiting list.
        function decisionAllowed() {
          let e = get(eventPath(eventId)).data;
          let r = request.resource.data;
          return isOrgAdmin(e.orgId)
            && resource.data.status in ['pending', 'waitlist', 'going']
            && r.status in ['going', 'declined', 'waitlist'] && r.status != resource.data.status
            && r.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'updatedAt'])
            && r.decidedBy == request.auth.uid && r.decidedAt == request.time && r.updatedAt == request.time
            && countsStep(e.counts, getAfter(eventPath(eventId)).data.counts, resource.data.status, r.status)
            && existsAfter(goingPath(eventId, uid)) == (r.status == 'going');
        }

        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'status', 'ticketTypeId', 'answers', 'registeredAt', 'createdAt', 'updatedAt'])
          && request.resource.data.createdAt == request.time
          && joinAllowed('none');

        allow update: if (isSelf(uid) && (
            (resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'name', 'registeredAt', 'updatedAt'])
              && joinAllowed('cancelled'))
            || cancelAllowed()))
          || decisionAllowed();
      }

      // Who's going: a first name per approved volunteer, readable by anyone who can see the event. Written by the
      // volunteer, or by an admin approving them.
      match /going/{uid} {
        allow read: if canSee(get(eventPath(eventId)).data);
        allow create: if (isSelf(uid) || isOrgAdmin(get(eventPath(eventId)).data.orgId))
          && statusAfter(eventId, uid) == 'going'
          && request.resource.data.keys().hasOnly(['name', 'since'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.since == request.time;
        allow delete: if (isSelf(uid) || isOrgAdmin(get(eventPath(eventId)).data.orgId))
          && statusAfter(eventId, uid) != 'going';
      }

      // Attendance: the volunteer reads their own; the organisation's admins and staff record it for volunteers
      // who are going, and the attended count moves in the same write.
      match /attendance/{uid} {
        function validAttendance(a) {
          return a.keys().hasOnly(['uid', 'name', 'status', 'hours', 'checkedInAt', 'checkedInBy', 'checkedOutAt', 'checkedOutBy',
                   'confirmedAt', 'confirmedBy', 'claimedAt', 'autoConfirmAt', 'code', 'updatedAt', 'sample'])
            && a.uid == uid
            && a.get('sample', true) == true
            && a.status in ['checked_in', 'confirmed', 'claimed', 'declined']
            && a.hours is number && a.hours >= 0 && a.hours <= 24
            && (a.status != 'confirmed' || (a.confirmedAt is timestamp && a.confirmedBy is string))
            && a.updatedAt == request.time;
        }

        function attendedMoves() {
          return getAfter(eventPath(eventId)).data.counts.attended
            == get(eventPath(eventId)).data.counts.attended + step('confirmed', attendanceBefore(eventId, uid), attendanceAfter(eventId, uid));
        }

        allow read: if isSelf(uid) || isMember(get(eventPath(eventId)).data.orgId);

        allow create, update: if isMember(get(eventPath(eventId)).data.orgId)
          && statusBefore(eventId, uid) == 'going'
          && validAttendance(request.resource.data)
          && attendedMoves();

        allow delete: if isMember(get(eventPath(eventId)).data.orgId) && attendedMoves();

        // A volunteer who is going confirms their own hours by presenting the event's check-out code (section 7).
        // A check-in recorded by the organisation is kept as it was.
        function checkOutByCode() {
          let a = request.resource.data;
          return isSelf(uid) && statusBefore(eventId, uid) == 'going'
            && validAttendance(a)
            && a.name == get(regPath(eventId, uid)).data.name
            && a.status == 'confirmed' && a.confirmedBy == 'code'
            && a.confirmedAt == request.time && a.checkedOutAt == request.time && a.checkedOutBy == uid
            && a.hours == get(eventPath(eventId)).data.hours
            && a.code == get(/databases/$(database)/documents/events/$(eventId)/private/codes).data.checkOut
            && attendedMoves();
        }

        allow create: if checkOutByCode();
        allow update: if checkOutByCode()
          && resource.data.status in ['checked_in', 'claimed']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'status', 'hours', 'code', 'checkedOutAt', 'checkedOutBy', 'confirmedAt', 'confirmedBy', 'updatedAt']);

        // After the event ends, a volunteer who was going claims its hours without the code (section 7). A claim made
        // after the organisation checked them in confirms itself 7 days later (autoConfirmAt) unless the organisation
        // decides first; the client's clock sets autoConfirmAt, so it gets an hour either way.
        function claimByVolunteer() {
          let a = request.resource.data;
          let e = get(eventPath(eventId)).data;
          return isSelf(uid) && statusBefore(eventId, uid) == 'going'
            && request.time > e.endAt
            && validAttendance(a)
            && a.name == get(regPath(eventId, uid)).data.name
            && a.status == 'claimed' && a.claimedAt == request.time && a.hours == e.hours
            && ('checkedInAt' in a
              ? a.autoConfirmAt is timestamp
                && a.autoConfirmAt > request.time + duration.value(167, 'h')
                && a.autoConfirmAt < request.time + duration.value(169, 'h')
              : !('autoConfirmAt' in a))
            && attendedMoves();
        }

        allow create: if claimByVolunteer()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'status', 'hours', 'claimedAt', 'updatedAt']);
        allow update: if claimByVolunteer()
          && resource.data.status == 'checked_in'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'status', 'hours', 'claimedAt', 'autoConfirmAt', 'updatedAt']);

        // Phase 1 auto-confirm (section 8): the volunteer's own app confirms the claim once autoConfirmAt has passed,
        // and no sooner than 7 days after the claim by the server's clock. The attended count moves with it.
        function autoConfirm() {
          let a = request.resource.data;
          return isSelf(uid) && statusBefore(eventId, uid) == 'going'
            && resource.data.status == 'claimed'
            && resource.data.autoConfirmAt is timestamp
            && request.time >= resource.data.autoConfirmAt
            && request.time >= resource.data.claimedAt + duration.value(7, 'd')
            && validAttendance(a)
            && a.status == 'confirmed' && a.confirmedBy == 'auto' && a.confirmedAt == request.time
            && a.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt', 'confirmedBy', 'updatedAt'])
            && attendedMoves();
        }

        allow update: if autoConfirm();
      }

      // Check-in and check-out codes for the organisation; the exact venue also for approved volunteers.
      match /private/{docId} {
        allow read: if isMember(get(eventPath(eventId)).data.orgId)
          || (docId == 'location' && statusBefore(eventId, request.auth.uid) == 'going');

        // The codes are made with the event, by the admin creating it.
        allow create: if docId == 'codes'
          && isOrgAdmin(getAfter(eventPath(eventId)).data.orgId)
          && request.resource.data.keys().hasOnly(['checkIn', 'checkOut', 'rotatedAt'])
          && request.resource.data.checkIn is string && request.resource.data.checkIn.size() >= 8
          && request.resource.data.checkOut is string && request.resource.data.checkOut.size() >= 8
          && request.resource.data.rotatedAt == request.time;
      }
    }
  }
}
